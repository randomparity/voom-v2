// The reference user's whole-library policy (issue #288 / #269 Workstream D).
// It combines the shipped DSL operations:
//   MKV container + language-filtered keep + best audio/preserved subtitle defaults + order
//   (normalize), HEVC video profile (video), E-AC-3 5.1 plus a synthesized
//   stereo downmix (audio_companion), and an artifact verification (verify).
//   Each phase depends on the prior so every mutation sees the committed output
//   of the preceding operation.
policy "reference user library normalize" {
  metadata {
    version: "2"
    description: "mkv + hevc + eac3 5.1 + stereo downmix + language keep + verify"
  }

  config {
    languages: ["eng", "und"]
    on_error: continue
  }

  phase normalize {
    container mkv
    keep audio where language in ["eng", "und"]
    order tracks [video, audio, subtitle]
    defaults audio best
    defaults subtitle preserve
  }

  phase video {
    depends_on: [normalize]
    transcode video to hevc
  }

  phase audio_transcode {
    depends_on: [video]
    transcode audio to eac3 where language in ["eng", "und"]
  }

  phase audio_companion {
    depends_on: [audio_transcode]
    synthesize audio from channels >= 6 { codec aac  channels 2 }
  }

  phase verify {
    depends_on: [audio_companion]
    verify artifact
  }
}
